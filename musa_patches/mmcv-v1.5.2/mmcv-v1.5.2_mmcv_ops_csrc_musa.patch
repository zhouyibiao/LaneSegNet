diff --git a/mmcv/ops/csrc_musa/pytorch/mlu/bbox_overlaps_mlu.cpp b/mmcv/ops/csrc_musa/pytorch/mlu/bbox_overlaps_mlu.cpp
new file mode 100644
index 00000000..82d55559
--- /dev/null
+++ b/mmcv/ops/csrc_musa/pytorch/mlu/bbox_overlaps_mlu.cpp
@@ -0,0 +1,100 @@
+/*************************************************************************
