+#ifndef ROI_ALIGN_ROTATED_CUDA_KERNEL_MUH
+#define ROI_ALIGN_ROTATED_CUDA_KERNEL_MUH
+
+#include <float.h>
+#ifdef MMCV_WITH_TRT
+#include "common_cuda_helper.hpp"
+#else  // MMCV_WITH_TRT
+#ifdef MMCV_USE_PARROTS
+#include "parrots_cuda_helper.hpp"
+#else  // MMCV_USE_PARROTS
