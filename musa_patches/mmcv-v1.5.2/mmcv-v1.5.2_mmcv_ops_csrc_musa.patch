+at::Tensor DiffIoURotatedSortVerticesCUDAKernelLauncher(at::Tensor vertices,
+                                                        at::Tensor mask,
+                                                        at::Tensor num_valid) {
+  at::musa::MUSAGuard device_guard(vertices.device());
+  musaStream_t stream = at::musa::getCurrentMUSAStream();
+
+  CHECK_CONTIGUOUS(vertices);
